# Il wrapper di Gradle: il .jar e' un binario, lo genera Android Studio.
gradle/wrapper/gradle-wrapper.jar
gradlew
gradlew.bat

# Gli strumenti che `costruisci_apk.ps1` si scarica da solo: quasi un giga
# fra Gradle e l'SDK Android. Si cancella la cartella e non resta niente.
strumenti/

# Roba di costruzione
.gradle/
build/
app/build/
local.properties
*.apk
*.aab

# L'unica eccezione: l'apk pronto da scaricare col telefono. Sta nel
# repository apposta - il link e' quello di GitHub, si apre dal telefono e si
# installa senza passare da un computer. Tre megabyte e mezzo, uno solo, e si
# sovrascrive a ogni versione invece di accumularsi.
!/FantaHacked.apk
*.iml
.idea/
captures/

# Il risultato delle duecento aste giocate dal programma per computer: un
# mega che si rifa' in dieci minuti e cambia a ogni aggiornamento dei dati.
# Come rigenerarlo lo dice prove/index.html.
prove/attesi_aste.json

# I dati veri non stanno qui: si scaricano da DBFantaHacked.
# Quelli in prove/dati servono solo alle prove di equivalenza, e ci stanno.
